        "jsCode": "const output = $input.first().json.output;\nconst match = output.match(/\\[TRANSFERIR\\]\\s*(.*)/s);\nconst resumen = match ? match[1].trim() : output;\n\nreturn [{ json: {\n  resumen,\n  clienteId: $('Preparar ID Cliente').item.json.clienteId,\n  channel: $('Preparar ID Cliente').item.json.channel,\n  senderId: $('Preparar ID Cliente').item.json.senderId\n}}];"
