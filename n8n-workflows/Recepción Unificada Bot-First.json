        3216
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst prevData = $('Extraer Resumen Transferencia').item.json;\n\nconst mensajeTransferencia = `${prevData.resumen}\\n\\nUn asesor se comunicará con usted en breve.`;\n\n// 1. Guardar en BD via backend\nconst backendUrl = 'https://dashboard-frontenddemo.larlxe.easypanel.host';\nawait fetch(`${backendUrl}/api/webhook/n8n`, {\n  method: 'POST',\n  headers: { 'Content-Type': 'application/json' },\n  body: JSON.stringify({\n    cliente_id: prevData.clienteId,\n    contenido: mensajeTransferencia,\n    remitente: 'bot',\n    tipo: 'texto'\n  })\n});\n\n// 2. Enviar via workflow de entrega (entregar-mensaje)\nconst n8nUrl = 'https://n8n.supricom.com.ve/webhook/entregar-mensaje';\nconst channel = prevData.channel;\nconst senderId = prevData.senderId;\n\nconst payload = {\n  canal: channel,\n  contenido: mensajeTransferencia,\n  tipo: 'texto',\n  cliente_id: prevData.clienteId\n};\n\n// Agregar identificador según canal\nif (channel === 'facebook') {\n  payload.facebook_psid = senderId;\n} else if (channel === 'instagram') {\n  payload.instagram_psid = senderId;\n} else if (channel === 'whatsapp') {\n  payload.telefono = senderId;\n}\n\nawait fetch(n8nUrl, {\n  method: 'POST',\n  headers: { 'Content-Type': 'application/json' },\n  body: JSON.stringify(payload)\n});\n\nreturn [{ json: { success: true } }];"
      },
