{
  "name": "Recepción Unificada",
  "nodes": [
    {
      "id": "sticky-01",
      "name": "Flujo: Recepción Unificada",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-1152, 16],
      "parameters": {
        "content": "## Flujo: Recepción Unificada\n\n1. Recibe mensaje vía webhook (Evolution API / FB / IG)\n2. Normaliza datos del mensaje (senderId, channel)\n3. Buffer Redis: acumula mensajes por 7s (debounce anti-chunks)\n4. Busca cliente por columna dinámica (telefono/facebook_psid/instagram_psid según channel)\n5. Crea cliente nuevo si no existe\n6. Guarda mensaje en BD\n7. Verifica SLA de 15 min\n8. Si no respondió agente, activa IA",
        "height": 200,
        "width": 400
      }
    },
    {
      "id": "webhook-reception",
      "name": "Webhook Reception",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [-1152, 256],
      "webhookId": "webhook-reception-unificada",
      "parameters": {
        "httpMethod": "POST",
        "path": "receive-message",
        "options": {}
      }
    },
    {
      "id": "normalize-msg",
      "name": "Normalizar Mensaje",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-864, 256],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "assign-sender-id",
              "name": "senderId",
              "value": "={{ $json.body?.sender ?? $json.body?.senderId ?? $json.sender ?? \"\" }}",
              "type": "string"
            },
            {
              "id": "assign-msg",
              "name": "message",
              "value": "={{ $json.body?.message ?? $json.message ?? \"\" }}",
              "type": "string"
            },
            {
              "id": "assign-channel",
              "name": "channel",
              "value": "={{ $json.body?.channel ?? $json.channel ?? \"whatsapp\" }}",
              "type": "string"
            },
            {
              "id": "assign-ts",
              "name": "timestamp",
              "value": "={{ $json.body?.timestamp ?? $json.timestamp ?? $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "assign-name",
              "name": "clientName",
              "value": "={{ $json.body?.name ?? $json.body?.pushName ?? $json.name ?? \"\" }}",
              "type": "string"
            },
            {
              "id": "assign-conv-id",
              "name": "conversacionId",
              "value": "={{ $json.body?.conversacionId ?? $json.conversacionId ?? $json.body?.sender ?? $json.sender ?? $json.senderId }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "redis-push",
      "name": "Agregar Mensaje a Cola",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [-480, 256],
      "parameters": {
        "operation": "push",
        "list": "={{ $json.conversacionId?.toString() }}",
        "messageData": "={ JSON.stringify({ mensaje: $json.message, timestamp: $json.timestamp, senderId: $json.senderId, channel: $json.channel, clientName: $json.clientName }) }",
        "tail": true
      },
      "credentials": {
        "redis": {
          "id": "redis-conn",
          "name": "Redis n8n"
        }
      }
    },
    {
      "id": "redis-get",
      "name": "Consultar Historial Temporal",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [-192, 256],
      "parameters": {
        "operation": "get",
        "propertyName": "Mensaje",
        "keyType": "list",
        "key": "={{ $json.conversacionId?.toString() }}",
        "options": {}
      },
      "credentials": {
        "redis": {
          "id": "redis-conn",
          "name": "Redis n8n"
        }
      }
    },
    {
      "id": "switch-timer",
      "name": "Pasaron 7s de silencio",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [96, 256],
      "parameters": {
        "dataType": "number",
        "value1": "",
        "value2": "",
        "rules": {
          "values": [
            {
              "outputKey": "Tiempo cumplido (Responder)",
              "renameOutput": true,
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "cond-time-elapsed",
                    "leftValue": "={{ DateTime.fromJSDate(new Date(JSON.parse($json.Mensaje[0]).timestamp)).toISO() }}",
                    "operator": {
                      "type": "dateTime",
                      "operation": "before"
                    },
                    "rightValue": "={{ $now.minus({ seconds: 7 }).toISO() }}"
                  }
                ],
                "combinator": "and"
              }
            }
          ],
          "options": {
            "fallbackOutput": "extra",
            "renameFallbackOutput": "Aún escribiendo (Reintentar)"
          }
        },
        "options": {}
      }
    },
    {
      "id": "wait-debounce",
      "name": "Ciclo de Debounce (7s)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [96, 512],
      "webhookId": "wait-debounce-recepcion",
      "parameters": {
        "resume": "timeInterval",
        "amount": 7,
        "unit": "seconds"
      }
    },
    {
      "id": "redis-delete",
      "name": "Limpiar Buffer de Conversación",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [336, 128],
      "parameters": {
        "operation": "delete",
        "key": "={{ $json.conversacionId?.toString() }}"
      },
      "credentials": {
        "redis": {
          "id": "redis-conn",
          "name": "Redis n8n"
        }
      }
    },
    {
      "id": "concat-msgs",
      "name": "Concatenar Mensajes",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [576, 128],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "concat-msg",
              "name": "message",
              "value": "={{ $json.Mensaje.map(m => JSON.parse(m).mensaje).join('\\n') }}",
              "type": "string"
            },
            {
              "id": "concat-sid",
              "name": "senderId",
              "value": "={{ JSON.parse($json.Mensaje[0]).senderId }}",
              "type": "string"
            },
            {
              "id": "concat-chn",
              "name": "channel",
              "value": "={{ JSON.parse($json.Mensaje[0]).channel ?? $json.channel ?? \"whatsapp\" }}",
              "type": "string"
            },
            {
              "id": "concat-nm",
              "name": "clientName",
              "value": "={{ JSON.parse($json.Mensaje[0]).clientName ?? $json.clientName ?? \"\" }}",
              "type": "string"
            },
            {
              "id": "concat-cid",
              "name": "conversacionId",
              "value": "={{ $json.conversacionId ?? JSON.parse($json.Mensaje[0]).conversacionId ?? $json.senderId }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "build-search-col",
      "name": "Definir Columna Búsqueda",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [816, 128],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "search-col",
              "name": "searchColumn",
              "value": "={{ $json.channel == \"whatsapp\" ? \"telefono\" : ($json.channel == \"facebook\" ? \"facebook_psid\" : \"instagram_psid\") }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "mysql-buscar",
      "name": "Buscar Cliente",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [1056, 128],
      "alwaysOutputData": true,
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT * FROM clientes WHERE {{ $json.searchColumn }} = \"{{ $json.senderId }}\" LIMIT 1",
        "options": {}
      },
      "credentials": {
        "mySql": {
          "id": "mysql-conn",
          "name": "MySQL Demo"
        }
      }
    },
    {
      "id": "if-cliente-existe",
      "name": "Cliente existe?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [1296, 128],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-cliente-id",
              "leftValue": "={{ $json.id }}",
              "operator": {
                "type": "number",
                "operation": "notEmpty",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "mysql-crear",
      "name": "Crear Cliente Nuevo",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [1296, 384],
      "parameters": {
        "operation": "insert",
        "table": {
          "__rl": true,
          "mode": "list",
          "value": "clientes"
        },
        "dataMode": "defineBelow",
        "valuesToSend": {
          "values": [
            {
              "column": "telefono",
              "value": "={{ $json.channel == \"whatsapp\" ? $json.senderId : null }}"
            },
            {
              "column": "facebook_psid",
              "value": "={{ $json.channel == \"facebook\" ? $json.senderId : null }}"
            },
            {
              "column": "instagram_psid",
              "value": "={{ $json.channel == \"instagram\" ? $json.senderId : null }}"
            },
            {
              "column": "nombre",
              "value": "={{ $json.clientName }}"
            },
            {
              "column": "canal_origen",
              "value": "={{ $json.channel }}"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "mySql": {
          "id": "mysql-conn",
          "name": "MySQL Demo"
        }
      }
    },
    {
      "id": "prep-cliente-id",
      "name": "Preparar ID Cliente",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1568, 128],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "assign-cliente-id",
              "name": "clienteId",
              "value": "={{ $json.id ?? $json.insertId }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "mysql-guardar-msg",
      "name": "Guardar Mensaje en BD",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [1808, 128],
      "parameters": {
        "operation": "insert",
        "table": {
          "__rl": true,
          "mode": "list",
          "value": "mensajes"
        },
        "dataMode": "defineBelow",
        "valuesToSend": {
          "values": [
            {
              "column": "cliente_id",
              "value": "={{ $json.clienteId }}"
            },
            {
              "column": "remitente",
              "value": "cliente"
            },
            {
              "column": "contenido",
              "value": "={{ $json.message }}"
            },
            {
              "column": "tipo",
              "value": "texto"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "mySql": {
          "id": "mysql-conn",
          "name": "MySQL Demo"
        }
      }
    },
    {
      "id": "mysql-verificar-sla",
      "name": "Verificar SLA 15 min",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [2048, 128],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COUNT(*) as agente_respondio FROM mensajes WHERE cliente_id = ? AND remitente = 'agente' AND fecha_envio >= NOW() - INTERVAL 15 MINUTE",
        "options": {
          "queryReplacement": "={{ $json.clienteId }}"
        }
      },
      "credentials": {
        "mySql": {
          "id": "mysql-conn",
          "name": "MySQL Demo"
        }
      }
    },
    {
      "id": "if-sla-cumplido",
      "name": "Agente respondió?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [2288, 128],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-sla",
              "leftValue": "={{ $json.agente_respondio }}",
              "operator": {
                "type": "number",
                "operation": "larger",
                "singleValue": true
              },
              "rightValue": "0"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "fin-sla",
      "name": "SLA OK - Agente responde",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [2528, 16],
      "parameters": {}
    },
    {
      "id": "activar-bot",
      "name": "Activar Bot IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [2528, 256],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WEBHOOK_BOT_URL || \"http://n8n:5678/webhook/bot-contingencia\" }}",
        "authentication": "none",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\n  \"clienteId\": {{ $json.clienteId }},\n  \"message\": \"{{ $json.message }}\",\n  \"senderId\": \"{{ $json.senderId }}\",\n  \"channel\": \"{{ $json.channel }}\",\n  \"clientName\": \"{{ $json.clientName }}\"\n}",
        "options": {}
      }
    }
  ],
  "pinData": {},
